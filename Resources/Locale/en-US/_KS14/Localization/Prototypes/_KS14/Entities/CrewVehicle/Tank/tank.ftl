# Resources\Prototypes\_KS14\Entities\CrewVehicle\Tank\tank.yml
ent-KsCrewVehicleTank = tank
    .desc = A tracked, armoured fighting vehicle with a turret cannon and a machine gun beside it. Four fit inside; the driver aims and fires both guns.
    .suffix = Full racks
ent-KsCrewVehicleTankEmpty = tank
    .desc = A tracked, armoured fighting vehicle with a turret cannon and a machine gun beside it. Four fit inside; the driver aims and fires both guns.
    .suffix = Empty racks
ent-KsCrewVehicleWeaponTankCannon = tank cannon
    .desc = A long-barrelled cannon in a turret, loaded one shell at a time from inside.
ent-KsCrewVehicleWeaponTankCoax = coaxial machine gun
    .desc = A belt-fed machine gun fixed beside the tank's cannon, aimed with the turret.
ent-KsCrewVehicleWeaponTankCoaxIndependent = turret machine gun
    .desc = A belt-fed machine gun on its own small mount, aimed by a gunner of its own.
ent-KsCrewVehicleTankWreck = tank wreck
    .desc = What's left of a tank. It won't be going anywhere.
